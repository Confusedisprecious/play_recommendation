{
  "policy": {
    "publish_requires_review": true,
    "login_automation": false,
    "undocumented_api": false,
    "copy_full_content": false,
    "candidate_output": "data/social_candidates.json"
  },
  "authorized_connectors": [
    {
      "id": "xiaohongshu",
      "label": "小红书",
      "adapters": [
        "opencli",
        "xiaohongshu-mcp",
        "redbook",
        "Agent-Reach",
        "MediaCrawler"
      ],
      "mode": "authorized_local_export",
      "publish_requires_review": true,
      "credential_scope": "local_only"
    },
    {
      "id": "douyin",
      "label": "抖音",
      "adapters": [
        "MediaCrawler",
        "Agent-Reach"
      ],
      "mode": "authorized_local_export",
      "publish_requires_review": true,
      "credential_scope": "local_only"
    }
  ],
  "search": {
    "provider": "SearXNG",
    "base_url_env": "SEARXNG_BASE_URL",
    "queries": [
      "武汉 亲子 周末 活动",
      "武汉 遛娃 新展览",
      "武汉 周末去哪玩",
      "武汉 夜游 新玩法",
      "武汉 景区 最新 开放",
      "武汉 商场 亲子 活动",
      "武汉 商场 新店 展览",
      "site:xiaohongshu.com 武汉 亲子 周末",
      "site:douyin.com 武汉 景区 实拍"
    ],
    "allowed_domains": [
      "wuhan.gov.cn",
      "wlj.wuhan.gov.cn",
      "news.cjn.cn",
      "news.hbtv.com.cn",
      "weibo.com",
      "xiaohongshu.com",
      "douyin.com",
      "bilibili.com"
    ]
  },
  "authorized_social_search": {
    "strategy": "category_rotation",
    "max_queries_per_run": 7,
    "max_results_per_query": 6,
    "max_age_days": 30,
    "groups": [
      {
        "id": "current-events",
        "label": "本周活动",
        "queries": [
          "武汉 本周 活动",
          "武汉 周末 市集 演出"
        ]
      },
      {
        "id": "indoor-weather",
        "label": "天气与室内",
        "queries": [
          "武汉 雨天 室内遛娃",
          "武汉 高温 室内 亲子"
        ]
      },
      {
        "id": "culture",
        "label": "展览与场馆",
        "queries": [
          "武汉 免费展览 近期",
          "武汉 博物馆 亲子 预约"
        ]
      },
      {
        "id": "outdoor",
        "label": "公园与户外",
        "queries": [
          "武汉 公园 玩水",
          "武汉 亲子 徒步 骑行"
        ]
      },
      {
        "id": "night",
        "label": "夜游",
        "queries": [
          "武汉 夏日夜游",
          "武汉 江滩 东湖 夜场"
        ]
      },
      {
        "id": "openings",
        "label": "开放与预约",
        "queries": [
          "武汉 景区开放 预约",
          "武汉 新开 乐园 亲子"
        ]
      },
      {
        "id": "commercial",
        "label": "商圈与新店",
        "queries": [
          "武汉 商场 首店 快闪",
          "武汉 商圈 亲子 活动"
        ]
      },
      {
        "id": "nearby",
        "label": "武汉周边",
        "queries": [
          "武汉 周边 亲子 一日游",
          "武汉 出发 短途 自驾"
        ]
      },
      {
        "id": "districts",
        "label": "区域轮换",
        "queries": [
          "武汉 汉口 遛娃",
          "武汉 汉阳 亲子活动",
          "武汉 武昌 周末",
          "武汉 光谷 江夏 周边游"
        ]
      }
    ]
  },
  "feeds": {
    "provider": "RSSHub",
    "base_url_env": "RSSHUB_BASE_URL",
    "routes": []
  },
  "news_rss": {
    "provider": "Bing News RSS",
    "enabled": true,
    "endpoint": "https://www.bing.com/news/search",
    "max_age_days": 30,
    "max_items": 24,
    "title_include_terms": [
      "亲子",
      "遛娃",
      "活动",
      "景区",
      "公园",
      "商场",
      "展览",
      "市集",
      "游乐",
      "乐园",
      "博物馆",
      "科技馆",
      "演出",
      "夜游",
      "露营",
      "采摘",
      "花海",
      "开放",
      "预约"
    ],
    "exclude_terms": [
      "台风",
      "恢复营业",
      "高铁站",
      "高铁圈",
      "交换游",
      "江豚",
      "社区妇联",
      "生产车间"
    ],
    "queries": [
      "武汉 亲子 活动",
      "武汉 亲子 暑期",
      "武汉 景区 暑期",
      "武汉 景区 最新 开放",
      "武汉 公园 展览",
      "武汉 商场 亲子",
      "武汉 商场 新店 展览",
      "武汉 夜游 活动",
      "武汉 周末去哪玩"
    ],
    "auto_publish_domains": [
      "wuhan.gov.cn",
      "wlj.wuhan.gov.cn",
      "news.hbtv.com.cn"
    ]
  }
}
